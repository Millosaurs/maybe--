{
    "name": "server",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts && tsc-alias",
        "check-types": "tsc -b",
        "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "hono": "catalog:",
        "@hono/node-server": "^1.14.4",
        "@orpc/server": "catalog:",
        "@orpc/openapi": "catalog:",
        "@orpc/zod": "catalog:",
        "better-auth": "catalog:",
        "dotenv": "catalog:",
        "zod": "^4.1.11",
        "@maybe-will-work/api": "workspace:*",
        "@maybe-will-work/auth": "workspace:*",
        "@maybe-will-work/db": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^5.8.2",
        "tsx": "^4.19.2",
        "@types/node": "^22.13.11",
        "tsup": "^8.0.0",
        "tsc-alias": "^1.8.10",
        "@maybe-will-work/config": "workspace:*"
    }
}
