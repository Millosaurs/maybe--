{
    "name": "@maybe-will-work/api",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./context": {
            "types": "./dist/context.d.ts",
            "default": "./dist/context.js"
        },
        "./routers": {
            "types": "./dist/routers/index.d.ts",
            "default": "./dist/routers/index.js"
        },
        "./routers/index": {
            "types": "./dist/routers/index.d.ts",
            "default": "./dist/routers/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsup src/index.ts src/context.ts src/routers/index.ts --format esm --dts && tsc-alias"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "tsc-alias": "^1.8.10",
        "@maybe-will-work/config": "workspace:*"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@orpc/server": "catalog:",
        "@orpc/client": "catalog:",
        "@orpc/openapi": "catalog:",
        "@orpc/zod": "catalog:",
        "hono": "catalog:",
        "dotenv": "catalog:",
        "zod": "^4.1.11",
        "@maybe-will-work/auth": "workspace:*",
        "@maybe-will-work/db": "workspace:*"
    }
}
